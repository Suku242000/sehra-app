modules = ["nodejs-20"]
[nix]
channel = "stable-24_05"

[workflows]
runButton = "Run"

[[workflows.workflow]]
name = "Run"
author = 41371325
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd sehra-project/sehra-backend && node index.js"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd sehra-project/sehra-frontend && npm start"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80
